{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neon-arena-game",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/health"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARENA_HUB",
        "class_name": "ArenaHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArenaHub"]
    }
  ]
}
